  "key_innovations": [
    "Improved Training: warmup+cosine+label_smoothing (largest gain +2-5%)",
    "Extended Training: 700-1200 steps vs 300-400",
    "Larger Q channels: q_channels=64 for FashionMNIST (+1%)",
    "Multi-seed Ensemble: +0.5-0.7% consistent gain",
    "FourierGlobalMix: enabled 98.2-98.4% MNIST with Enhanced models"
  ],
  "failed_approaches": [
    "DirectFieldFormer (bypass Q-compression): 46.7% random accuracy",
    "Data augmentation (RandAugment): 90.5% -> 71% on FashionMNIST",
    "Wider h channels on FashionMNIST: consistently underperformed",
    "Deep stacking >2 layers: ADR explosion + Q-compression loss"
  ],
  "why_2_layers_limit": [
    "ADR reaction term R(J) unbounded -> field norm explosion",
    "Q-compression -> reconstruction cycle destroys information (6-9x error)",
    "Inter-layer disconnection: Layer2 cannot receive original input",
    "These are FUNDAMENTAL to FluidNet Q-compression, not fixable by wrappers"
  ],
  "files": {
